# ================================================================
# KANAL TIGA RENTAL ELEKTRONIK — SISTEM MASTER DATA AKUNTANSI
# Template Variabel Environment (.env.example)
# ================================================================

# 1. URL Koneksi Neon Serverless PostgreSQL (Pilih opsi "Pooled connection")
# Contoh format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Secret Key untuk Stateless JWT (jose)
JWT_SECRET="kanal-tiga-secret-key-purwokerto-2026-aman-super-secret"

# 3. Environment
NODE_ENV="development"
